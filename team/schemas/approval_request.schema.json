{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "approval_request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "case_id",
    "requested_by",
    "action",
    "payload_hash",
    "expires_at",
    "state",
    "single_use",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "approval_request"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^apr_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^cas_[0-9a-f]{32}$"
    },
    "requested_by": {
      "type": "string",
      "pattern": "^(usr|agt|sys)_[0-9a-f]{32}$"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovada",
        "negada",
        "expirada",
        "usada",
        "cancelada"
      ]
    },
    "single_use": {
      "type": "boolean"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(usr|agt|sys)_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
