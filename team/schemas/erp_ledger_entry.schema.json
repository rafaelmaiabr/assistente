{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "erp_ledger_entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "namespace",
    "provider",
    "entry_key",
    "payload",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "erp_ledger_entry"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^led_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "namespace": {
      "type": "string",
      "enum": [
        "charge",
        "event",
        "emission"
      ]
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "entry_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "payload": {
      "type": "object"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
