{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contact_address",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "channel",
    "address",
    "link_state",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "contact_address"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^adr_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "contact_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ctc_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "telefone"
      ]
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "link_state": {
      "type": "string",
      "enum": [
        "observado",
        "vinculado"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
