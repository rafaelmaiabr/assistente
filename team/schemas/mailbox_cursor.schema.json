{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mailbox_cursor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "connection_id",
    "department_id",
    "folder",
    "last_uid",
    "resets",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "mailbox_cursor"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^mbx_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "connection_id": {
      "type": "string",
      "pattern": "^con_[0-9a-f]{32}$"
    },
    "department_id": {
      "type": "string",
      "pattern": "^dep_[0-9a-f]{32}$"
    },
    "folder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "uidvalidity": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "last_uid": {
      "type": "integer"
    },
    "resets": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
