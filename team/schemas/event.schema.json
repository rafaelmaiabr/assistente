{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "type",
    "correlation_id",
    "actor_id",
    "revision",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "kind": {
      "const": "event"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^cas_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^cor_[0-9a-f]{32}$"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(cmd|evt)_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_id": {
      "type": "string",
      "pattern": "^(usr|agt|sys)_[0-9a-f]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
