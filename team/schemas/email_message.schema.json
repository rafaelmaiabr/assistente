{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "email_message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "connection_id",
    "folder",
    "uidvalidity",
    "uid",
    "references",
    "sender",
    "recipients",
    "classification",
    "identity",
    "subject_hash",
    "body_hash",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "email_message"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^eml_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "connection_id": {
      "type": "string",
      "pattern": "^con_[0-9a-f]{32}$"
    },
    "folder": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "uidvalidity": {
      "type": "integer",
      "minimum": 1
    },
    "uid": {
      "type": "integer",
      "minimum": 1
    },
    "message_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "in_reply_to": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "sender": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "sender_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "nova_demanda",
        "resposta",
        "resposta_nao_confirmada",
        "ignorada_autoresposta",
        "ignorada_loop",
        "duplicada"
      ]
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^cas_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity": {
      "type": "string",
      "enum": [
        "nao_verificada",
        "contato_vinculado"
      ]
    },
    "subject_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "body_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
