{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent_profile_version",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "agent_id",
    "agent_version",
    "definition",
    "content_hash",
    "status",
    "created_by",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "agent_profile_version"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^apv_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9a-f]{32}$"
    },
    "agent_version": {
      "type": "integer",
      "minimum": 1
    },
    "definition": {
      "type": "object"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ]
    },
    "created_by": {
      "type": "string",
      "pattern": "^(usr|agt|sys)_[0-9a-f]{32}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
