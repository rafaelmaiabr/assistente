{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "notification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "severity",
    "topic",
    "dedupe_key",
    "message",
    "state",
    "count",
    "last_seen_at",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "notification"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^ntf_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "atencao",
        "acao"
      ]
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "subject_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "nova",
        "lida"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
