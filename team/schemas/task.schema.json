{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "case_id",
    "assignee_agent_id",
    "state",
    "objective",
    "expected_result",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "task"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^tsk_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^cas_[0-9a-f]{32}$"
    },
    "parent_task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "assignee_agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9a-f]{32}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "pendente",
        "em_execucao",
        "aguardando",
        "concluida",
        "falhou",
        "cancelada"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "expected_result": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "due_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
