{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "connection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "label",
    "provider",
    "connection_kind",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "connection"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^con_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "connection_kind": {
      "type": "string",
      "enum": [
        "mcp",
        "imap",
        "smtp",
        "http",
        "outro"
      ]
    },
    "transport": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "http",
            "sse",
            "stdio"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "endpoint": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        {
          "type": "null"
        }
      ]
    },
    "credential_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^crd_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
