{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory_item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "scope",
    "memory_kind",
    "text",
    "state",
    "source",
    "proposed_by",
    "observed_at",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "memory_item"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^mem_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "empresa",
        "departamento",
        "cliente"
      ]
    },
    "department_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^dep_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "memory_kind": {
      "type": "string",
      "enum": [
        "preferencia",
        "fato"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "state": {
      "type": "string",
      "enum": [
        "proposta",
        "confirmada",
        "rejeitada",
        "expirada"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "proposed_by": {
      "type": "string",
      "pattern": "^(usr|agt|sys)_[0-9a-f]{32}$"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(usr|agt|sys)_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "decided_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
