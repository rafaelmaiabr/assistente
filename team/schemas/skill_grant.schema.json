{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skill_grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "agent_id",
    "skill_id",
    "skill_version",
    "operations",
    "granted_by",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "skill_grant"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^grt_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9a-f]{32}$"
    },
    "skill_id": {
      "type": "string",
      "pattern": "^skl_[0-9a-f]{32}$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "connection_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^con_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "send",
          "spend"
        ]
      }
    },
    "resource": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "granted_by": {
      "type": "string",
      "pattern": "^(usr|agt|sys)_[0-9a-f]{32}$"
    },
    "revoked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
