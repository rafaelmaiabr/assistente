{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent_run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "agent_id",
    "agent_version",
    "department_id",
    "state",
    "budget",
    "skill_versions",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "agent_run"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^agt_[0-9a-f]{32}$"
    },
    "agent_version": {
      "type": "integer",
      "minimum": 1
    },
    "department_id": {
      "type": "string",
      "pattern": "^dep_[0-9a-f]{32}$"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^cas_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "enfileirada",
        "em_execucao",
        "pausada",
        "concluida",
        "falhou",
        "cancelada",
        "expirada"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_steps",
        "token_budget",
        "deadline_seconds"
      ],
      "properties": {
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "token_budget": {
          "type": "integer",
          "minimum": 1
        },
        "deadline_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "skill_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
