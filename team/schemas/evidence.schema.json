{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "case_id",
    "source",
    "collected_at",
    "summary",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "evidence"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^evd_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^cas_[0-9a-f]{32}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "content_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "fato",
            "resultado_ferramenta",
            "recibo",
            "documento"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reliability": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "verificada",
            "declarada",
            "inferida"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "recorded_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(usr|agt|sys)_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
