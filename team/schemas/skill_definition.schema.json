{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "skill_definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "skill_key",
    "skill_version",
    "content_hash",
    "instructions",
    "required_tools",
    "operations",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "skill_definition"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^skl_[0-9a-f]{32}$"
    },
    "skill_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "required_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "send",
          "spend"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
