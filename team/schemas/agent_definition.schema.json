{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent_definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "department_id",
    "agent_version",
    "name",
    "personality",
    "scope",
    "out_of_scope",
    "skill_grant_ids",
    "handoff_target_ids",
    "model_policy_ref",
    "status",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "agent_definition"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^agt_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "department_id": {
      "type": "string",
      "pattern": "^dep_[0-9a-f]{32}$"
    },
    "agent_version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "personality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tone",
        "initiative"
      ],
      "properties": {
        "tone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "initiative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        }
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "out_of_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "skill_grant_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^grt_[0-9a-f]{32}$"
      }
    },
    "handoff_target_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^agt_[0-9a-f]{32}$"
      }
    },
    "model_policy_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "voice_profile_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
