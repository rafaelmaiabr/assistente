{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "department_id",
    "state",
    "objective",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "case"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^cas_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "department_id": {
      "type": "string",
      "pattern": "^dep_[0-9a-f]{32}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "recebida",
        "triagem",
        "em_execucao",
        "aguardando_cliente",
        "aguardando_aprovacao",
        "aguardando_subtarefa",
        "pausada",
        "resolvida",
        "falhou",
        "cancelada"
      ]
    },
    "owner_agent_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^agt_[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "customer_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "closed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "baixa",
            "normal",
            "alta",
            "urgente"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "operador",
            "chat",
            "email",
            "agendamento",
            "agente"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
