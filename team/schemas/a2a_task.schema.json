{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2a_task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "case_id",
    "connection_id",
    "requested_by",
    "message_id",
    "state",
    "objective",
    "expires_at",
    "attention",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "a2a_task"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^atk_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^cas_[0-9a-f]{32}$"
    },
    "connection_id": {
      "type": "string",
      "pattern": "^con_[0-9a-f]{32}$"
    },
    "requested_by": {
      "type": "string",
      "pattern": "^(usr|agt|sys)_[0-9a-f]{32}$"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "remote_task_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "remote_state": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "desconhecido",
        "pendente",
        "em_execucao",
        "aguardando",
        "concluida",
        "falhou",
        "cancelada",
        "expirada"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "expected_result": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "checked_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_text": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        {
          "type": "null"
        }
      ]
    },
    "attention": {
      "type": "boolean"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
