{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "credential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "label",
    "store",
    "state",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "credential"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^crd_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "store": {
      "type": "string",
      "enum": [
        "cofre-local",
        "elevenlabs-legado"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "ativa",
        "revogada"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
