{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contact_link",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "id",
    "tenant_id",
    "contact_id",
    "department_id",
    "relation",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "kind": {
      "const": "contact_link"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^lnk_[0-9a-f]{32}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^ten_[0-9a-f]{32}$"
    },
    "contact_id": {
      "type": "string",
      "pattern": "^ctc_[0-9a-f]{32}$"
    },
    "department_id": {
      "type": "string",
      "pattern": "^dep_[0-9a-f]{32}$"
    },
    "relation": {
      "type": "string",
      "enum": [
        "cliente",
        "fornecedor",
        "interno",
        "outro"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
